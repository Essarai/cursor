# CSCD
# 方式一：直接填 ApiCode（约 10 分钟有效）
CSCD_API_CODE=
# 方式二：用户名密码，自动调用 GET /getApiCode 获取（推荐）
CSCD_USER=academax
CSCD_PASSWORD=
CSCD_BASE_URL=http://sciencechina.cn/cscdboot/CscdService
CSCD_SEARCH_ARTICLES_MAX_PER_SEC=3

# MiniMax（默认 LLM）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 可选：其他 OpenAI 兼容接口
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=

# Agent
AGENT_RECENT_PAPER_YEARS=3
AGENT_STAGE1_MIN_OVERLAP=0.5
AGENT_STAGE1_MAX_SELECTED=25
MEMORY_DB_PATH=data/tool_memory.db

# HTTP API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*
