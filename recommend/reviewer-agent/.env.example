# CSCD
# 方式一：直接填 ApiCode（约 10 分钟有效）
CSCD_API_CODE=
# 方式二：用户名密码，自动调用 GET /getApiCode 获取（推荐）
CSCD_USER=academax
CSCD_PASSWORD=
CSCD_BASE_URL=http://sciencechina.cn/cscdboot/CscdService
CSCD_SEARCH_ARTICLES_MAX_PER_SEC=3

# MiniMax（默认 LLM）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 可选：其他 OpenAI 兼容接口
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=

# Agent
AGENT_RECENT_PAPER_YEARS=3
AGENT_STAGE1_MIN_OVERLAP=0.5
AGENT_STAGE1_MAX_SELECTED=25
# 阶段三：agent（ReAct 工具决策，默认）| oneshot（单次 JSON 精筛）
AGENT_STAGE3_MODE=agent
AGENT_STAGE3_MAX_STEPS=4
AGENT_STAGE3_MAX_TOOL_CALLS=6
AGENT_STAGE3_MAX_TOOLS_PER_STEP=3
AGENT_STAGE3_TEMPERATURE=0.1
# 阶段二融合重排：fusion = overlap×W1 + activity_norm×W2
AGENT_FUSION_OVERLAP_WEIGHT=0.7
AGENT_FUSION_ACTIVITY_WEIGHT=0.3
MEMORY_DB_PATH=data/tool_memory.db

# HTTP API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*
