# CSCD API 配置（复制为 .env.local）

# 方式一：直接使用 ApiCode（约 10 分钟有效）
CSCD_API_CODE=

# 方式二：用户名密码（ApiCode 过期时自动刷新，推荐）
CSCD_USER=
CSCD_PASSWORD=

# 可选
# CSCD_BASE_URL=http://sciencechina.cn/cscdboot/CscdService

# MySQL（CSCD 检索结果入库，专家按 cscd_author_id 去重更新）
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=cscd_recommend
