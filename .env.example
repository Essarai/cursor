# CSCD
# 优先：环境变量 CSCD_API_CODE（约 10 分钟有效）
# 缺失或业务报 AppCode 过期后：再用 USER/PASSWORD 调 getApiCode
CSCD_API_CODE=
CSCD_USER=academax
CSCD_PASSWORD=
CSCD_BASE_URL=http://sciencechina.cn/cscdboot/CscdService
CSCD_SEARCH_ARTICLES_MAX_PER_SEC=3

# MiniMax（默认 LLM）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 可选：其他 OpenAI 兼容接口
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=

# Agent
AGENT_RECENT_PAPER_YEARS=3
AGENT_STAGE1_MIN_OVERLAP=0.5
# 阶段一入选上限 = 召回人数 × 比例（默认 20%）
AGENT_STAGE1_MAX_RATIO=0.2
# 阶段二硬淘汰：近 AGENT_RECENT_PAPER_YEARS 年发文数下限
AGENT_STAGE2_MIN_RECENT_PUBS=5
# 多词重合度聚合：总分 = MAX_WEIGHT * max(各词分) + (1-MAX_WEIGHT) * mean
AGENT_OVERLAP_MAX_WEIGHT=0.6
# 阶段三：agent（ReAct 工具决策）| oneshot（单次 JSON 精筛，默认更快）
AGENT_STAGE3_MODE=oneshot
AGENT_STAGE3_MAX_STEPS=4
AGENT_STAGE3_MAX_TOOL_CALLS=6
AGENT_STAGE3_MAX_TOOLS_PER_STEP=3
AGENT_STAGE3_TEMPERATURE=0.1
# 阶段二融合重排：fusion = overlap×W1 + activity_norm×W2
AGENT_FUSION_OVERLAP_WEIGHT=0.7
AGENT_FUSION_ACTIVITY_WEIGHT=0.3
MEMORY_DB_PATH=data/tool_memory.db

# HTTP API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*

# Railway：平台会注入 PORT，无需设置 API_PORT。
# 在 Railway Variables 中至少配置：
#   CSCD_USER / CSCD_PASSWORD（或 CSCD_API_CODE）
#   MINIMAX_API_KEY
# 可选：MINIMAX_BASE_URL / MINIMAX_MODEL / AGENT_* / MEMORY_DB_PATH
